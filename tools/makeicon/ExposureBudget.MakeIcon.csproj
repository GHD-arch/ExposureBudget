<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>ExposureBudget.MakeIcon</AssemblyName>
    <RootNamespace>NINA.Plugin.ExposureBudget.MakeIcon</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <StartupObject>NINA.Plugin.ExposureBudget.MakeIcon.Program</StartupObject>
    <NinaSdkPath Condition="'$(NinaSdkPath)' == ''">C:\Program Files\N.I.N.A. - Nighttime Imaging 'N' Astronomy</NinaSdkPath>
  </PropertyGroup>

  <!-- Outil de preparation : il rasterise l'icone calculatrice de N.I.N.A.
       (ressource CalculatorSVG de NINA.WPF.Base) en PNG, pour que le plugin
       puisse l'afficher dans sa fiche (Descriptions.FeaturedImageURL).
       A relancer si N.I.N.A. change d'icone. -->
  <ItemGroup>
    <Reference Include="NINA.Core">
      <HintPath>$(NinaSdkPath)\NINA.Core.dll</HintPath>
    </Reference>
    <Reference Include="NINA.WPF.Base">
      <HintPath>$(NinaSdkPath)\NINA.WPF.Base.dll</HintPath>
    </Reference>
    <Reference Include="NINA.Profile">
      <HintPath>$(NinaSdkPath)\NINA.Profile.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
